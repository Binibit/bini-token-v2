{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binibit.com/schemas/v1-v2-known-holders.json",
  "title": "BINI V1 to V2 holder accounting record",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "holderId",
      "v1Address",
      "v2Recipient",
      "v1RawAmount",
      "v2RawAmount",
      "sourceAllocationId",
      "sourceTopLevelSafe",
      "beneficiaryType",
      "ownershipProof",
      "migrationMethod",
      "vestingTreatment",
      "batch",
      "status"
    ],
    "properties": {
      "holderId": {"type": "string", "minLength": 1},
      "v1Address": {"$ref": "#/$defs/address"},
      "v2Recipient": {"$ref": "#/$defs/address"},
      "v1RawAmount": {"type": "string", "pattern": "^[1-9][0-9]*$"},
      "v2RawAmount": {"type": "string", "pattern": "^[1-9][0-9]*$"},
      "sourceAllocationId": {"$ref": "#/$defs/allocationId"},
      "sourceTopLevelSafe": {"$ref": "#/$defs/address"},
      "beneficiaryType": {"type": "string", "minLength": 1},
      "ownershipProof": {
        "enum": ["PENDING", "VERIFIED_SIGNATURE", "SAFE_RECORD", "ONCHAIN_PROOF", "LEGAL_ATTESTATION"]
      },
      "migrationMethod": {
        "enum": ["SELF_SERVICE", "OPERATOR_ASSISTED", "PROJECT_CONTROLLED_WALLET"]
      },
      "vestingTreatment": {
        "enum": ["NONE", "PRESERVE_EXISTING_SCHEDULE", "NEW_VESTING_REQUIRED", "RESERVE_ONLY"]
      },
      "batch": {"type": "string", "minLength": 1},
      "status": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"},
    "allocationId": {
      "enum": [
        "rewards-year-1",
        "rewards-year-2-reserve",
        "rewards-year-3-reserve",
        "rewards-year-4-reserve",
        "team-founders-reserve",
        "marketing-operations",
        "marketing-milestone-reserve",
        "ecosystem-reserve",
        "dex-liquidity-reserve"
      ]
    }
  }
}

# Public deployment configuration only. Never put a mnemonic or raw private key here.
SEPOLIA_RPC_URL=https://sepolia.example.invalid
MAINNET_RPC_URL=https://mainnet.example.invalid
ETHERSCAN_API_KEY=

# Pin this independently to the reviewed release commit.
EXPECTED_GIT_COMMIT=

# PLAN is the default. Do not persist BROADCAST in a shared shell profile.
EXECUTION_MODE=PLAN
CONFIRM_MAINNET=no
EXPECTED_CHAIN_ID=11155111

# Encrypted Foundry keystore account created with `cast wallet import`.
DEPLOYER_ACCOUNT=bini-deployer
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://binibit.com/schemas/bini-v2-safe-signature-bundle.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "network", "chainId", "safe", "safeTxHash", "nonce", "transaction", "signatures", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "network": {"type": "string"}, "chainId": {"type": "integer"}, "safe": {"$ref": "#/$defs/address"},
    "safeTxHash": {"$ref": "#/$defs/hash"}, "nonce": {"type": "integer", "minimum": 0}, "transaction": {"type": "object"},
    "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}}, "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {"address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"}, "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}, "signature": {"type": "object", "additionalProperties": false, "required": ["accountName", "owner", "signature", "createdAt"], "properties": {"accountName": {"type": "string"}, "owner": {"$ref": "#/$defs/address"}, "signature": {"type": "string", "pattern": "^0x[0-9a-fA-F]{130}$"}, "createdAt": {"type": "string"}}}}
}

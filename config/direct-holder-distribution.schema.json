{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binibit.example/schemas/direct-holder-distribution.schema.json",
  "title": "BINI V2 immutable direct holder distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "network", "chainId", "snapshotBlock", "snapshotBlockHash", "sourceAllocationId", "sourceSafe", "tokenProxy", "conversionRule", "recipientCount", "totalAmountRaw", "batchSizeLimit", "manifestHash", "ownerApprovalReference", "records"],
  "properties": {
    "manifestVersion": {"type": "string", "minLength": 1},
    "network": {"enum": ["sepolia", "mainnet"]},
    "chainId": {"type": ["integer", "string"], "pattern": "^[0-9]+$"},
    "snapshotBlock": {"type": ["integer", "string"], "pattern": "^[0-9]+$"},
    "snapshotBlockHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "sourceAllocationId": {"enum": ["rewards-year-1", "rewards-year-2-reserve", "rewards-year-3-reserve", "rewards-year-4-reserve", "team-founders-reserve", "marketing-operations", "marketing-milestone-reserve", "ecosystem-reserve", "dex-liquidity-reserve"]},
    "sourceSafe": {"$ref": "#/$defs/address"},
    "tokenProxy": {"$ref": "#/$defs/address"},
    "conversionRule": {"const": "v2RawAmount = v1RawAmount * 1000000 (12->18 decimals)"},
    "recipientCount": {"type": ["integer", "string"], "pattern": "^[0-9]+$"},
    "totalAmountRaw": {"type": ["integer", "string"], "pattern": "^[0-9]+$"},
    "batchSizeLimit": {"type": ["integer", "string"], "pattern": "^[0-9]+$"},
    "manifestHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "SHA-256 of canonical sorted compact JSON after removing manifestHash."},
    "ownerApprovalReference": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "hash": {"type": "string", "pattern": "^(0x|sha256:)[0-9a-fA-F]{64}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holderId", "legacyV1Address", "destinationAddress", "v1RawAmount", "v2RawAmount", "sourceAllocationId", "sourceSafe", "proofType", "addressOverride", "addressOverrideProofHash", "batch", "indexInBatch", "status"],
      "properties": {
        "holderId": {"type": "string", "minLength": 1},
        "legacyV1Address": {"$ref": "#/$defs/address"},
        "destinationAddress": {"$ref": "#/$defs/address"},
        "v1RawAmount": {"type": ["integer", "string"], "pattern": "^[0-9]+$"},
        "v2RawAmount": {"type": ["integer", "string"], "pattern": "^[0-9]+$"},
        "sourceAllocationId": {"type": "string"},
        "sourceSafe": {"$ref": "#/$defs/address"},
        "proofType": {"type": "string", "minLength": 1},
        "addressOverride": {"type": "boolean"},
        "addressOverrideProofHash": {"$ref": "#/$defs/hash"},
        "batch": {"type": ["integer", "string"], "pattern": "^[0-9]+$"},
        "indexInBatch": {"type": ["integer", "string"], "pattern": "^[0-9]+$"},
        "status": {"const": "PLANNED"}
      }
    }
  }
}

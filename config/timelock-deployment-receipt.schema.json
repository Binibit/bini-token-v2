{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binibit.com/schemas/bini-v2-timelock-deployment-receipt.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "network", "chainId", "address", "proposer", "executor", "canceller", "minimumDelaySeconds", "admin", "deployer", "deploymentTransaction", "deploymentBlock", "broadcastReceipt", "sourceCommit", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "network": {"type": "string"}, "chainId": {"type": "integer"},
    "address": {"$ref": "#/$defs/address"}, "proposer": {"$ref": "#/$defs/address"}, "executor": {"$ref": "#/$defs/address"},
    "canceller": {"$ref": "#/$defs/address"}, "minimumDelaySeconds": {"type": "integer", "minimum": 1},
    "admin": {"$ref": "#/$defs/address"}, "deployer": {"$ref": "#/$defs/address"},
    "deploymentTransaction": {"$ref": "#/$defs/hash"}, "deploymentBlock": {"type": "integer", "minimum": 1},
    "broadcastReceipt": {"type": "string", "minLength": 1}, "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"},
    "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}
  }
}

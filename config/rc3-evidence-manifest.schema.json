{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binibit.com/schemas/bini-v2-rc3-evidence-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "network", "chainId", "sourceCommit", "workingTreeClean", "files", "requiredCategories", "presentCategories", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "network": {"type": "string"},
    "chainId": {"type": "integer"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workingTreeClean": {"type": "boolean"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "requiredCategories": {"type": "array", "items": {"type": "string"}},
    "presentCategories": {"type": "array", "items": {"type": "string"}},
    "createdAt": {"type": "string"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binibit.com/schemas/bini-v2-migration.json",
  "title": "BINI V2 Phase 2 migration configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network", "phase", "chainId", "illustrativeInputs", "v1Token", "v2Proxy",
    "migrationVault", "conversionFactor", "fundingReserveSafe", "fundingReserveRaw",
    "migrationStart", "holderManifestHash", "expectedVaultCreationBytecodeHash"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "network": {"type": "string", "minLength": 1},
    "phase": {"const": "PHASE_2"},
    "chainId": {"type": "integer", "minimum": 1},
    "illustrativeInputs": {"type": "boolean"},
    "v1Token": {"$ref": "#/$defs/address"},
    "v2Proxy": {"$ref": "#/$defs/address"},
    "migrationVault": {"$ref": "#/$defs/address"},
    "conversionFactor": {"const": "1000000"},
    "fundingReserveSafe": {"$ref": "#/$defs/address"},
    "fundingReserveRaw": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "migrationStart": {"type": "string", "minLength": 1},
    "holderManifestHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expectedVaultCreationBytecodeHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"},
    "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binibit.com/schemas/bini-v2-test-accounts-public.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "network", "chainId", "sepoliaRehearsalOnly", "accounts", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "network": {"type": "string"},
    "chainId": {"type": "integer"},
    "sepoliaRehearsalOnly": {"const": true},
    "accounts": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/account"}},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"},
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountName", "label", "role", "address"],
      "properties": {
        "accountName": {"enum": ["bini-test-signer-1", "bini-test-signer-2", "bini-test-signer-3", "bini-sepolia-deployer"]},
        "label": {"enum": ["BINI_TEST_SIGNER_1", "BINI_TEST_SIGNER_2", "BINI_TEST_SIGNER_3", "BINI_SEPOLIA_DEPLOYER"]},
        "role": {"enum": ["SAFE_OWNER", "DEPLOYER"]},
        "address": {"$ref": "#/$defs/address"}
      }
    }
  }
}

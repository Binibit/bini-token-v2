{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binibit.com/schemas/bini-v2-governance-manifest.json",
  "title": "BINI V2 governance and deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network",
    "chainId",
    "rpcEnv",
    "expectedGitCommit",
    "illustrativeInputs",
    "expectedTokenCreationBytecodeHash",
    "expectedVaultCreationBytecodeHash",
    "minDeployerBalanceWei",
    "timelockMinDelay",
    "adminTransferDelay",
    "timelockProposerSafe",
    "timelockExecutorSafe",
    "emergencyPauserSafe",
    "genesisDistributionSafe",
    "treasurySafe",
    "liquiditySafe",
    "rewardsSafe",
    "strategicReserveSafe",
    "biniV1Token",
    "safeThresholds",
    "dexPolicy"
  ],
  "properties": {
    "network": {"type": "string", "minLength": 1},
    "chainId": {"type": "integer", "minimum": 1},
    "rpcEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "expectedGitCommit": {"type": "string", "minLength": 7},
    "illustrativeInputs": {"type": "boolean"},
    "expectedTokenCreationBytecodeHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "expectedVaultCreationBytecodeHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "minDeployerBalanceWei": {"type": "string", "pattern": "^[0-9]+$"},
    "timelockMinDelay": {"type": "integer", "minimum": 1},
    "adminTransferDelay": {"type": "integer", "minimum": 0, "maximum": 281474976710655},
    "timelockProposerSafe": {"$ref": "#/$defs/address"},
    "timelockExecutorSafe": {"$ref": "#/$defs/address"},
    "emergencyPauserSafe": {"$ref": "#/$defs/address"},
    "genesisDistributionSafe": {"$ref": "#/$defs/address"},
    "treasurySafe": {"$ref": "#/$defs/address"},
    "liquiditySafe": {"$ref": "#/$defs/address"},
    "rewardsSafe": {"$ref": "#/$defs/address"},
    "strategicReserveSafe": {"$ref": "#/$defs/address"},
    "biniV1Token": {"$ref": "#/$defs/address"},
    "safeThresholds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^0x[0-9a-fA-F]{40}$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "dexPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factories", "infrastructure"],
      "properties": {
        "factories": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "address", "runtimeCodeHash"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "kind": {"enum": ["UNISWAP_V2", "UNISWAP_V3"]},
              "address": {"$ref": "#/$defs/address"},
              "runtimeCodeHash": {"$ref": "#/$defs/hash"}
            }
          }
        },
        "infrastructure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "address", "runtimeCodeHash"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "address": {"$ref": "#/$defs/address"},
              "runtimeCodeHash": {"$ref": "#/$defs/hash"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"},
    "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}
  }
}

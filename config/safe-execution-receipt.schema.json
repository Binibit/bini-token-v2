{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://binibit.com/schemas/bini-v2-safe-execution-receipt.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "network", "chainId", "safe", "safeTxHash", "nonce", "transactionHash", "blockNumber", "status", "signers", "transaction", "rawReceipt", "verifiedAt"],
  "properties": {"schemaVersion": {"const": "1.0"}, "network": {"type": "string"}, "chainId": {"type": "integer"}, "safe": {"$ref": "#/$defs/address"}, "safeTxHash": {"$ref": "#/$defs/hash"}, "nonce": {"type": "integer"}, "transactionHash": {"$ref": "#/$defs/hash"}, "blockNumber": {"type": "integer"}, "status": {"const": "EXECUTED"}, "signers": {"type": "array", "items": {"$ref": "#/$defs/address"}}, "transaction": {"type": "object"}, "rawReceipt": {"type": "object"}, "verifiedAt": {"type": "string"}},
  "$defs": {"address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"}, "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}}
}

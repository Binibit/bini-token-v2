{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binibit.com/schemas/bini-v2-dex-policy.json",
  "title": "BINI V2 Phase 3 supported DEX policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["network", "phase", "chainId", "illustrativeInputs", "expectedPolicyState", "factories", "infrastructure"],
  "properties": {
    "$schema": {"type": "string"},
    "network": {"type": "string", "minLength": 1},
    "phase": {"const": "PHASE_3"},
    "chainId": {"type": "integer", "minimum": 1},
    "illustrativeInputs": {"type": "boolean"},
    "expectedPolicyState": {"const": "PRE_MARKET_BLOCKED"},
    "factories": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "kind", "address", "runtimeCodeHash"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["UNISWAP_V2", "UNISWAP_V3"]},
          "address": {"$ref": "#/$defs/address"},
          "runtimeCodeHash": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "infrastructure": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "kind", "address", "runtimeCodeHash"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["POOL_MANAGER", "ROUTER", "POSITION_MANAGER", "LIQUIDITY_MANAGER", "GATEWAY"]},
          "address": {"$ref": "#/$defs/address"},
          "runtimeCodeHash": {"$ref": "#/$defs/hash"}
        }
      }
    }
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"},
    "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}
  }
}

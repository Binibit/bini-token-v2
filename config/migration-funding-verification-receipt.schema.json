{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binibit.com/schemas/bini-v2-migration-funding-verification-receipt.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "network", "chainId", "vault", "fundingSources", "totalRaw", "verifiedAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "network": {"type": "string"},
    "chainId": {"type": "integer"},
    "vault": {"$ref": "#/$defs/address"},
    "fundingSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceAllocationId", "sourceTopLevelSafe", "amountRaw", "package", "receipt", "transactionHash"],
        "properties": {
          "sourceAllocationId": {"type": "string", "minLength": 1},
          "sourceTopLevelSafe": {"$ref": "#/$defs/address"},
          "amountRaw": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "package": {"type": "string", "minLength": 1},
          "receipt": {"type": "string", "minLength": 1},
          "transactionHash": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "totalRaw": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "verifiedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"},
    "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}
  }
}

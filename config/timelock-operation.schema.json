{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://binibit.com/schemas/bini-v2-timelock-operation.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "network", "chainId", "timelock", "proposerSafe", "cancellerSafe", "executorSafe", "target", "value", "data", "predecessor", "salt", "delaySeconds", "operationId", "description", "createdAt"],
  "properties": {"schemaVersion": {"const": "1.0"}, "network": {"type": "string"}, "chainId": {"type": "integer"}, "timelock": {"$ref": "#/$defs/address"}, "proposerSafe": {"$ref": "#/$defs/address"}, "cancellerSafe": {"$ref": "#/$defs/address"}, "executorSafe": {"$ref": "#/$defs/address"}, "target": {"$ref": "#/$defs/address"}, "value": {"type": "string", "pattern": "^[0-9]+$"}, "data": {"type": "string", "pattern": "^0x[0-9a-fA-F]*$"}, "predecessor": {"$ref": "#/$defs/hash"}, "salt": {"$ref": "#/$defs/hash"}, "delaySeconds": {"type": "string", "pattern": "^[0-9]+$"}, "operationId": {"$ref": "#/$defs/hash"}, "description": {"type": "string"}, "createdAt": {"type": "string"}},
  "$defs": {"address": {"type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"}, "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}}
}
